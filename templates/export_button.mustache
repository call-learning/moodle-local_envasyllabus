{{!
    @template local_envasyllabus/export_button

    Excel export button for catalog

    Example context (json):
    {
        "categoryid": 1,
        "extendedmode": true,
        "lang": "en"
    }
}}
<div class="export-excel-container">
    <button data-action="exportexcel"
       class="btn btn-secondary"
       title="{{#str}}exportexcel_help, local_envasyllabus{{/str}}">
        <i class="fa fa-download" aria-hidden="true"></i>
        <span class="sr-only">{{#str}}exportexcel, local_envasyllabus{{/str}}</span>
    </button>
</div>
{{#js}}
require(['local_envasyllabus/excel_export'], function(ExcelExport) {
    ExcelExport.init();
});
{{/js}}
