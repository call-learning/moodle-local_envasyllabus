{{!
    @template local_envasyllabus/catalog_course_category

    This template renders the courses categories as a list

    Example context (json):
    {
        "nocoursesimg": "https://moodlesite/theme/image.php/boost/block_myoverview/1535727318/courses",
        "grouping": "all",
        "sort": "fullname"
    }
}}
<div id="catalog-course-category-{{uniqid}}" class="local-envasyllabus-ccat">
    {{#sortedCourses}}
        {{#semesters}}
            {{#semester}}
            <h3 class="listheader{{#gridview}} mb-3{{/gridview}}">{{#str}}
                course_semester, local_envasyllabus, { "semester": {{#quote}}{{semester}}{{/quote}}, "year": {{#quote}}{{year}}{{/quote}} } {{/str}}</h3>
            {{/semester}}
            {{^semester}}
                <h3 class="{{#gridview}}text-center{{/gridview}}">{{#str}}
                    course_no_semester, local_envasyllabus, {{year}} {{/str}}</h3>
            {{/semester}}
            {{#gridview}}
                <div class="catalog-grid" role="list">
                    {{#courses}}
                    {{>local_envasyllabus/catalog_course}}
                    {{/courses}}
                </div>
            {{/gridview}}
            {{#listview}}
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th scope="col" class="w-25">{{#str}}th:uc, local_envasyllabus{{/str}}</th>
                            <th scope="col" class="w-10">{{#str}}th:acronym, local_envasyllabus{{/str}}</th>
                            <th scope="col" class="w-15">{{#str}}th:responsible, local_envasyllabus{{/str}}</th>
                            <th scope="col">{{#str}}th:ects, local_envasyllabus{{/str}}</th>
                            {{#extendedmodus}}
                                {{#programmecolumns}}
                                    <th scope="col" data-id="{{column}}" {{#help}}class="hashelp" data-toggle="popover" data-placement="bottom" data-html="true" data-content="{{{help}}}"{{/help}}>{{label}}</th>
                                {{/programmecolumns}}
                            {{/extendedmodus}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#courses}}
                            {{>local_envasyllabus/table_course}}
                        {{/courses}}
                        {{#totals}}
                            <tr class="table-active font-weight-bold">
                                <td colspan="3" class="text-right"><strong>Total</strong></td>
                                <td class="ects-column"><strong>{{cf.uc_ects.value}}</strong></td>
                                {{#extendedmodus}}
                                    {{#programmevalues}}
                                        <td class="column" data-id="{{column}}"><strong>{{sum}}</strong></td>
                                    {{/programmevalues}}
                                {{/extendedmodus}}
                            </tr>
                        {{/totals}}
                    </tbody>
                </table>
            {{/listview}}
        {{/semesters}}
    {{/sortedCourses}}
    {{#chartview}}
        {{>local_envasyllabus/catalog_chart}}
    {{/chartview}}
</div>
